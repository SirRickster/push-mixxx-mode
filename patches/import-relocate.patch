+void TrackCollection::relocateTracks(const QList<QPair<QString, QString>>& moves) {
+    DEBUG_ASSERT_QOBJECT_THREAD_AFFINITY(this);
+    SqlTransaction transaction(m_database);
+    QSqlQuery known(m_database);
+    known.prepare(QStringLiteral("SELECT 1 FROM track_locations WHERE location=:loc"));
+    QSqlQuery find(m_database);
+    find.prepare(QStringLiteral(
+            "SELECT library.id,track_locations.id FROM library INNER JOIN "
+            "track_locations ON track_locations.id=library.location "
+            "WHERE track_locations.location=:loc"));
+    QSqlQuery update(m_database);
+    update.prepare(QStringLiteral(
+            "UPDATE track_locations SET location=:loc,directory=:dir,"
+            "filename=:file,fs_deleted=0,needs_verification=0 WHERE id=:id"));
+    QList<RelocatedTrack> relocatedTracks;
+    QList<std::pair<TrackId, TrackId>> merges; // duplicate -> track at the copy
+    for (const auto& [oldLocation, newLocation] : moves) {
+        const mixxx::FileInfo newFile(newLocation);
+        if (!newFile.exists()) {
+            continue;
+        }
+        // a track in two imported playlists: the first import moved it to
+        // the copy, so the second import added it again at the stick path.
+        // merge that duplicate into the track at the copy.
+        find.bindValue(QStringLiteral(":loc"), newFile.location());
+        if (find.exec() && find.next()) {
+            const TrackId keepId(find.value(0));
+            find.bindValue(QStringLiteral(":loc"), oldLocation);
+            if (find.exec() && find.next() && TrackId(find.value(0)) != keepId) {
+                merges.append({TrackId(find.value(0)), keepId});
+            }
+            continue;
+        }
+        known.bindValue(QStringLiteral(":loc"), newFile.location());
+        if (!known.exec() || known.next()) {
+            continue; // already in the library at the new place
+        }
+        find.bindValue(QStringLiteral(":loc"), oldLocation);
+        if (!find.exec() || !find.next()) {
+            continue;
+        }
+        const TrackId trackId(find.value(0));
+        update.bindValue(QStringLiteral(":loc"), newFile.location());
+        update.bindValue(QStringLiteral(":dir"), newFile.locationPath());
+        update.bindValue(QStringLiteral(":file"), newFile.fileName());
+        update.bindValue(QStringLiteral(":id"), find.value(1));
+        if (!update.exec()) {
+            kLogger.warning() << "push-hack: could not relocate" << oldLocation;
+            continue;
+        }
+        relocatedTracks.append(RelocatedTrack(
+                TrackRef::fromFilePath(oldLocation, trackId),
+                TrackRef::fromFileInfo(newFile)));
+    }
+    transaction.commit();
+    if (!relocatedTracks.isEmpty()) {
+        kLogger.info() << "push-hack: relocated" << relocatedTracks.size() << "imported tracks";
+        m_trackDao.slotDatabaseTracksRelocated(std::move(relocatedTracks));
+        GlobalTrackCacheLocker().relocateCachedTracks(&m_trackDao);
+    }
+    if (merges.isEmpty()) {
+        return;
+    }
+    // put the kept track where the duplicate is in each playlist, then purge
+    // the duplicate (its own transaction, playlists and crates included).
+    QSqlQuery position(m_database);
+    position.prepare(QStringLiteral(
+            "SELECT position FROM PlaylistTracks WHERE playlist_id=:pl AND track_id=:id"));
+    QList<TrackId> duplicates;
+    for (const auto& [dupId, keepId] : merges) {
+        QSet<int> playlists;
+        m_playlistDao.getPlaylistsTrackIsIn(dupId, &playlists);
+        for (const int playlistId : std::as_const(playlists)) {
+            position.bindValue(QStringLiteral(":pl"), playlistId);
+            position.bindValue(QStringLiteral(":id"), dupId.toVariant());
+            if (position.exec() && position.next()) {
+                m_playlistDao.insertTrackIntoPlaylist(keepId, playlistId, position.value(0).toInt());
+            }
+        }
+        duplicates.append(dupId);
+    }
+    purgeTracks(duplicates);
+    kLogger.info() << "push-hack: merged" << duplicates.size() << "duplicate imported tracks";
+}
