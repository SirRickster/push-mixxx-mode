+
+    // push-hack: mixxx-bridge copies imported Rekordbox tracks to the Push,
+    // then drops [[old, new], ...] into import-ready.json in the settings
+    // dir. repoint those tracks right away instead of on the next start.
+    const QString settingsPath = m_pConfig->getSettingsPath();
+    auto* pImportWatcher = new QFileSystemWatcher(QStringList{settingsPath}, this);
+    connect(pImportWatcher,
+            &QFileSystemWatcher::directoryChanged,
+            this,
+            [this, readyPath = QDir(settingsPath).filePath(QStringLiteral("import-ready.json"))] {
+                QFile file(readyPath);
+                if (!file.open(QIODevice::ReadOnly)) {
+                    return;
+                }
+                const QJsonArray pairs = QJsonDocument::fromJson(file.readAll()).array();
+                file.remove();
+                QList<QPair<QString, QString>> moves;
+                for (const auto& pair : pairs) {
+                    const QJsonArray p = pair.toArray();
+                    moves.append({p.at(0).toString(), p.at(1).toString()});
+                }
+                m_pTrackCollectionManager->internalCollection()->relocateTracks(moves);
+            });
 }
 
