+    // push-hack: "Import as Playlist" on the selected sidebar item, so a
+    // controller can import a Rekordbox (or other external library) playlist
+    // without the right-click menu. Any other item: nothing happens.
+    m_pImportPlaylist = std::make_unique<ControlPushButton>(
+            ConfigKey("[Library]", "import_playlist"));
+    connect(m_pImportPlaylist.get(),
+            &ControlPushButton::valueChanged,
+            this,
+            [this](double value) {
+                if (value <= 0.0 || !m_pSidebarWidget) {
+                    return;
+                }
+                const QModelIndex index = m_pSidebarWidget->currentIndex();
+                // top-level items point at the model, children at a TreeItem
+                if (!index.isValid() || index.internalPointer() == index.model()) {
+                    return;
+                }
+                TreeItem* pTreeItem = static_cast<TreeItem*>(index.internalPointer());
+                auto* pFeature = qobject_cast<BaseExternalLibraryFeature*>(pTreeItem->feature());
+                if (pFeature) {
+                    pFeature->importAsMixxxPlaylist(index);
                 }
             });
