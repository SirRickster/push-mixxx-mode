<!DOCTYPE template>
<!-- one deck's scrolling waveform, full width, height = what the layout leaves, 3-band like rekordbox:
     low blue outside, mid amber inside, high white core (band gains: mode.go). vars: i (deck number) -->
<Template>
  <SetVariable name="group">[Channel<Variable name="i"/>]</SetVariable>
  <Visual>
    <Channel><Variable name="i"/></Channel>
    <Size>1me,16me</Size>
    <BgColor>#000000</BgColor>
    <SignalColor>#1F5FFF</SignalColor>
    <SignalHighColor>#FFFFFF</SignalHighColor>
    <SignalMidColor>#FFA319</SignalMidColor>
    <SignalLowColor>#1F5FFF</SignalLowColor>
    <SignalRGBLowColor>#1F5FFF</SignalRGBLowColor>
    <SignalRGBMidColor>#FFA319</SignalRGBMidColor>
    <SignalRGBHighColor>#FFFFFF</SignalRGBHighColor>
    <BeatColor>#808080</BeatColor>
    <PlayPosColor>#FFFFFF</PlayPosColor>
    <EndOfTrackColor>#EA0000</EndOfTrackColor>
    <AxesColor>#000000</AxesColor>
    <DefaultMark>
      <Align>top</Align>
      <Color>#FFC516</Color>
      <TextColor>#000000</TextColor>
      <Text> %1 </Text>
    </DefaultMark>
    <Mark>
      <Control>cue_point</Control>
      <Text>CUE</Text>
      <Align>top</Align>
      <Color>#FF4032</Color>
      <TextColor>#FFFFFF</TextColor>
    </Mark>
    <Mark>
      <Control>loop_start_position</Control>
      <Text>IN</Text>
      <Align>bottom</Align>
      <Color>#FFA319</Color>
      <TextColor>#000000</TextColor>
    </Mark>
    <Mark>
      <Control>loop_end_position</Control>
      <Text>OUT</Text>
      <Align>bottom</Align>
      <Color>#FFA319</Color>
      <TextColor>#000000</TextColor>
    </Mark>
    <MarkRange>
      <StartControl>loop_start_position</StartControl>
      <EndControl>loop_end_position</EndControl>
      <EnabledControl>loop_enabled</EnabledControl>
      <Color>#FFA319</Color>
      <Opacity>0.45</Opacity>
      <DisabledColor>#666666</DisabledColor>
      <DisabledOpacity>0.3</DisabledOpacity>
    </MarkRange>
  </Visual>
</Template>
