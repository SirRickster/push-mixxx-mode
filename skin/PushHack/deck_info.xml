<!DOCTYPE template>
<!-- one deck's info line, full width x 12: number, title, bpm, tempo, time,
     master, flags. vars: i (deck number). number badge lit while the Push
     controls this deck ([PushHack],active<i>) -->
<Template>
  <SetVariable name="group">[Channel<Variable name="i"/>]</SetVariable>
  <WidgetGroup>
    <ObjectName>InfoRow</ObjectName>
    <Layout>horizontal</Layout>
    <Size>1me,12f</Size>
    <Children>
      <Label>
        <ObjectName>DeckNum<Variable name="i"/></ObjectName>
        <Size>20f,12f</Size>
        <Text><Variable name="i"/></Text>
        <Alignment>center</Alignment>
        <Connection><ConfigKey>[PushHack],active<Variable name="i"/></ConfigKey><BindProperty>highlight</BindProperty></Connection>
      </Label>
      <!-- title over the deck level (level.xml). a stacked layout lowers each
           child it adds, so the first child is on top: title first -->
      <WidgetGroup>
        <ObjectName>TitleArea</ObjectName>
        <Layout>stacked</Layout>
        <Size>1me,12f</Size>
        <Children>
          <TrackProperty>
            <ObjectName>Title</ObjectName>
            <Size>1me,12f</Size>
            <Property>titleInfo</Property>
            <Group><Variable name="group"/></Group>
            <Elide>right</Elide>
          </TrackProperty>
          <Template src="skin:level.xml"/>
        </Children>
      </WidgetGroup>
      <NumberBpm>
        <ObjectName>Bpm</ObjectName>
        <Size>64f,12f</Size>
        <Group><Variable name="group"/></Group>
        <Connection><ConfigKey><Variable name="group"/>,visual_bpm</ConfigKey></Connection>
      </NumberBpm>
      <NumberRate>
        <ObjectName>Rate</ObjectName>
        <Size>50f,12f</Size>
        <Channel><Variable name="i"/></Channel>
        <NumberOfDigits>2</NumberOfDigits>
      </NumberRate>
      <NumberPos>
        <ObjectName>Time</ObjectName>
        <Size>120f,12f</Size>
        <Group><Variable name="group"/></Group>
      </NumberPos>
      <Label>
        <ObjectName>Flag</ObjectName>
        <Size>50f,12f</Size>
        <Text>MASTER</Text>
        <Alignment>center</Alignment>
        <Connection>
          <ConfigKey>[PushHack],master</ConfigKey>
          <Transform><IsEqual><Variable name="i"/></IsEqual></Transform>
          <BindProperty>highlight</BindProperty>
        </Connection>
      </Label>
      <Template src="skin:flag.xml"><SetVariable name="text">PLAY</SetVariable><SetVariable name="id">Play</SetVariable><SetVariable name="key"><Variable name="group"/>,play_indicator</SetVariable></Template>
      <Template src="skin:flag.xml"><SetVariable name="text">SYNC</SetVariable><SetVariable name="id">Sync</SetVariable><SetVariable name="key"><Variable name="group"/>,sync_enabled</SetVariable></Template>
      <Template src="skin:flag.xml"><SetVariable name="text">Q</SetVariable><SetVariable name="id">Quantize</SetVariable><SetVariable name="key"><Variable name="group"/>,quantize</SetVariable></Template>
      <Template src="skin:flag.xml"><SetVariable name="text">KEY</SetVariable><SetVariable name="id">Key</SetVariable><SetVariable name="key"><Variable name="group"/>,keylock</SetVariable></Template>
      <Template src="skin:flag.xml"><SetVariable name="text">LOOP</SetVariable><SetVariable name="id">Loop</SetVariable><SetVariable name="key"><Variable name="group"/>,loop_enabled</SetVariable></Template>
      <Template src="skin:flag.xml"><SetVariable name="text">CUE</SetVariable><SetVariable name="id">Cue</SetVariable><SetVariable name="key"><Variable name="group"/>,pfl</SetVariable></Template>
    </Children>
  </WidgetGroup>
</Template>
